# ============================================================
# Simulacro 2676 · variables de entorno
# Copia este archivo como .env.local (local) o cárgalas en Vercel
# (Project → Settings → Environment Variables). Nunca subas valores reales al repo.
# ============================================================

# --- Sitio ---------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com          # sin "/" final; se usa en redirecciones de pago y correos
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@tu-dominio.com
NEXT_PUBLIC_LEGAL_NAME=Nombre o razón social del responsable

# --- Supabase: proyecto "centra-log" (ya tiene las migraciones aplicadas) ---
NEXT_PUBLIC_SUPABASE_URL=https://nnfudjmautufeswvkytd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=                       # Project Settings → API → anon public
SUPABASE_SERVICE_ROLE_KEY=                           # SECRETA: solo servidor

# --- Jobs internos y cron -------------------------------------
INTERNAL_JOB_SECRET=                                 # SECRETA: cadena aleatoria de 32+ caracteres (openssl rand -hex 32)
CRON_SECRET=                                         # SECRETA: otra cadena aleatoria; Vercel la usa para llamar /api/cron/diario

# --- Correos (Resend, el mismo de CENTRA) ----------------------
RESEND_API_KEY=                                      # SECRETA: resend.com → API Keys (puede ser la misma de CENTRA o una nueva "simulacro")
EMAIL_FROM=Simulacro 2676 <no-reply@centrahoy.online>
ADMIN_ALERT_EMAIL=                                   # a dónde llegan alertas y el resumen diario

# --- Captcha (Cloudflare Turnstile, el mismo de CENTRA) -----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=                      # el secreto va en Supabase → Auth → Bot protection, no aquí

# --- Métricas ---------------------------------------------------
# USD_COP_RATE=4000                                  # TRM para estimar el margen en el panel de administración

# --- Inteligencia artificial ---------------------------------
AI_PROVIDER=anthropic                                # anthropic | openai
ANTHROPIC_API_KEY=                                   # SECRETA (console.anthropic.com)
# AI_MODEL=claude-opus-5-5                           # por defecto Opus 5.5; claude-sonnet-5-5 cuesta la mitad
# AI_EFFORT=medium                                   # low | medium | high
# Si usas OpenAI:
# OPENAI_API_KEY=
# OPENAI_MODEL=                                      # obligatorio con OpenAI (p. ej. el modelo que elijas en platform.openai.com)
# AI_PRICE_INPUT_PER_MTOK=                           # USD por millón de tokens, para el control de costo con modelos fuera de la tabla
# AI_PRICE_OUTPUT_PER_MTOK=

# --- Wompi (Dashboard → Desarrolladores) ---------------------
WOMPI_ENV=sandbox                                    # sandbox | production
NEXT_PUBLIC_WOMPI_PUBLIC_KEY=pub_test_xxx            # pub_prod_xxx en producción
WOMPI_PRIVATE_KEY=prv_test_xxx                       # SECRETA: consulta de transacciones y conciliación
WOMPI_INTEGRITY_SECRET=test_integrity_xxx            # SECRETA: "Secretos para integración técnica" → Integridad
WOMPI_EVENTS_SECRET=test_events_xxx                  # SECRETA: "Secretos para integración técnica" → Eventos
